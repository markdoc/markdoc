{
  "name": "markdoc-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts --no-frozen-lockfile",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "turbo run build lint type:check prettier:check test test:types marktest",
    "test": "turbo run test",
    "test:types": "turbo run test:types",
    "marktest": "turbo run marktest",
    "lint": "turbo run lint",
    "type:check": "turbo run type:check",
    "prettier": "turbo run prettier",
    "prettier:check": "turbo run prettier:check",
    "grammar": "pnpm --filter @markdoc/markdoc run grammar",
    "typedoc": "turbo run typedoc"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "turbo": "2.11.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
