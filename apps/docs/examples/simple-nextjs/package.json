{
  "name": "markdoc-simple-nextjs",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "pnpm lint && pnpm build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "type:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@markdoc/markdoc": "0.5.13",
    "@markdoc/next.js": "0.7.0",
    "js-yaml": "4.3.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module"
}
