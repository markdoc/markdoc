{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": ".build",
    "noEmitOnError": true
  },
  "include": [
    "src",
    "schema",
    "server.ts",
    "createContentManifest.ts",
    "webpack.config.ts"
  ]
}
