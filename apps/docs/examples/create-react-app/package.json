{
  "name": "markdoc-create-react-app",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "dependencies": {
    "@markdoc/markdoc": "latest",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "express": "^4.22.3",
    "glob": "^8.1.0",
    "js-yaml": "^4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start:client": "react-scripts start",
    "start:server": "pnpm build:server && node .server/server.js",
    "start": "concurrently \"pnpm start:client\" \"pnpm start:server\"",
    "build": "pnpm build:server && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:server": "tsc -p tsconfig.server.json",
    "type:check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "proxy": "http://localhost:4242",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/glob": "8.1.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "18.19.70",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "concurrently": "^7.6.0",
    "typescript": "4.9.5"
  }
}
