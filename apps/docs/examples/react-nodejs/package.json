{
  "name": "markdoc-react-nodejs",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "type": "module",
  "scripts": {
    "start:client": "vite",
    "start:server": "node server.ts",
    "start": "concurrently \"node server.ts\" \"vite\"",
    "build": "pnpm type:check && vite build",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@markdoc/markdoc": "latest",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "glob": "^8.1.0",
    "js-yaml": "^4.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "typescript": "6.0.3",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=24"
  }
