{
  "name": "@markdoc/next.js",
  "version": "0.7.0",
  "author": "Stripe, Inc.",
  "description": "Markdoc plugin for Next.js",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "test:types": "node tests/types/check.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@markdoc/markdoc": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "enhanced-resolve": "^5.26.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@markdoc/markdoc": "*",
    "next": "*",
    "react": "*"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markdoc/markdoc.git",
    "directory": "packages/next.js"
  },
  "bugs": {
    "url": "https://github.com/markdoc/markdoc/issues"
  },
  "homepage": "https://markdoc.dev/docs/examples/nextjs",
  "typesVersions": {
    "*": {
      "index": [
        "dist/index.d.ts"
      ],
      "loader": [
        "dist/loader.d.ts"
      ],
      "runtime": [
        "dist/runtime.d.ts"
      ],
      "tags": [
        "dist/tags.d.ts"
      ],
      "types": [
        "dist/types.d.ts"
      ]
    }
  }
}
