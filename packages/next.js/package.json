{
  "name": "@markdoc/next.js",
  "version": "0.6.2",
  "author": "Stripe, Inc.",
  "description": "Markdoc plugin for Next.js",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "type:check": "tsc --noEmit",
    "test": "jest",
    "test:types": "node tests/types/check.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.16.12",
    "@babel/plugin-transform-modules-commonjs": "^7.16.8",
    "@markdoc/markdoc": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "enhanced-resolve": "^5.10.0",
    "jest": "^30.5.1",
    "jest-util": "^30.5.1",
    "next": "*",
    "react": "*",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@markdoc/markdoc": "*",
    "next": "*",
    "react": "*"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markdoc/markdoc.git",
    "directory": "packages/next.js"
  },
  "bugs": {
    "url": "https://github.com/markdoc/markdoc/issues"
  },
  "homepage": "https://markdoc.dev/docs/nextjs",
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ],
      "^.+\\.jsx?$": "babel-jest"
    }
  },
  "typesVersions": {
    "*": {
      "index": [
        "dist/index.d.ts"
      ],
      "loader": [
        "dist/loader.d.ts"
      ],
      "runtime": [
        "dist/runtime.d.ts"
      ],
      "tags": [
        "dist/tags.d.ts"
      ],
      "types": [
        "dist/types.d.ts"
      ]
    }
  }
}
